# Programa de afiliados da Sienci Labs (https://sienci.com/affiliate-marketing-program/).
# Depois de aprovado, copie do seu link de afiliado o nome do parâmetro e o seu código
# (ex.: https://sienci.com/?sld=123 → PARAM=sld, ID=123) e salve como .env.local.
# Sem isso, os links levam só as UTMs (utm_source=carvcam), que não geram comissão.
VITE_SIENCI_AFFILIATE_PARAM=
VITE_SIENCI_AFFILIATE_ID=
