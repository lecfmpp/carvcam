# Sienci Labs affiliate program (https://sienci.com/affiliate-marketing-program/).
# Once approved, copy the parameter name and your code from your affiliate link
# (e.g. https://sienci.com/?sld=123 → PARAM=sld, ID=123) and save this as .env.local.
# Without them, links only carry the UTMs (utm_source=carvcam), which don't earn a commission.
VITE_SIENCI_AFFILIATE_PARAM=
VITE_SIENCI_AFFILIATE_ID=
