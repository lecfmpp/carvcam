{
  "name": "@gsender-next/ui",
  "version": "0.1.0",
  "private": true,
  "description": "CarvCAM: UI (Calm Precision design) and CAM engine for signs and plaques on Sienci Labs machines",
  "type": "module",
  "scripts": {
    "dev": "node scripts/local.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "local": "vite build && node scripts/local.mjs",
    "images:fetch": "node scripts/fetch-sienci-images.mjs",
    "bridge": "node bridge/server.mjs"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@gsender-next/cam-engine": "file:../cam-engine",
    "@supabase/supabase-js": "2.117.3",
    "fflate": "0.8.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "serialport": "^12.0.0",
    "three": "^0.170.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
