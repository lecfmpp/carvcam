{
  "name": "carvcam",
  "productName": "CarvCAM",
  "version": "0.1.0",
  "description": "Design, prepare and carve on your LongMill or AltMill, in one app.",
  "author": "CarvCAM",
  "license": "GPL-3.0-only",
  "homepage": "https://www.carvcam.com",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "start": "npm run prepare-app && electron .",
    "dist:win": "npm run prepare-app && electron-builder --win --x64 --config electron-builder.config.cjs",
    "dist:linux": "npm run prepare-app && electron-builder --linux --config electron-builder.config.cjs",
    "dist:mac": "npm run prepare-app && electron-builder --mac --config electron-builder.config.cjs",
    "dist:dir": "npm run prepare-app && electron-builder --win --x64 --dir --config electron-builder.config.cjs"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "serialport": "12.0.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
